# 复制本文件为 .env，放在 monorepo 根目录（learn-llm/.env）。
# 所有 stage 子项目共用这一份，配置读取逻辑集中在 config/index.ts。

# 中转站地址，通常是 https://xxx/v1 这种 OpenAI 兼容格式
API_BASE_URL=https://your-relay.example.com/v1
# 你的中转站 API key
API_KEY=sk-your-key
# 模型名，以中转站页面列出的为准，例如 gpt-4o-mini
MODEL=gpt-4o-mini

# ---------- 以下为可选，主要给阶段 3 使用 ----------
# 上下文预算（估算 token），调小能更快看到压缩
# CONTEXT_BUDGET_TOKENS=8000
# ReAct 最大步数
# MAX_STEPS=12
# 回答后是否自动抽取长期记忆（off 可省一次模型调用）
# MEMORY_EXTRACT=on
# 是否使用流式输出（中转站不支持 SSE 时设为 off）
# STREAM=on
